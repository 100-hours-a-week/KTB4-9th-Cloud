          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"prod\", pod=~\"cosmos-(auth|core|battle)-.*\", container!=\"\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"prod\", resource=\"memory\", pod=~\"cosmos-(auth|core|battle)-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Hikari 커넥션 (활성 / 대기)",
      "datasource": {
        "type": "prometheus",
