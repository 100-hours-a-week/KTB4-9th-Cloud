{
  "uid": "cosmos-service-overview",
  "title": "COSMOS 서비스 개요 (v3-john)",
  "tags": [
    "cosmos",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "배포 (새 ReplicaSet)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-v2"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(time() - kube_replicaset_created{namespace=\"prod\", replicaset=~\"cosmos-.*\"}) < 90",
        "step": "60s",
        "titleFormat": "배포",
        "textFormat": "{{replicaset}}",
        "useValueForTime": false
      },
      {
        "name": "Argo CD 동기화",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-v2"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(argocd_app_sync_total{phase=\"Succeeded\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "동기화",
        "textFormat": "{{name}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "사용자 증상 (Envoy, 기능 묶음 기준)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "기능 묶음별 요청 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-v2"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "sum by (journey) (cosmos:route_requests:rate5m)",
          "legendFormat": "{{journey}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "기능 묶음별 오류율 (5xx + 정상 엔드포인트 없음)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-v2"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.072
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "cosmos:journey_error_ratio:rate5m",
          "legendFormat": "{{journey}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "조회 p95 (로그인, 문제 조회)와 라우트별 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-v2"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "cosmos:read_latency_p95_ms:rate5m",
          "legendFormat": "조회 SLO"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "max by (route) (cosmos:route_latency_p95_ms:rate5m)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "핵심 기능 에러 예산 소진 속도 (배수)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-v2"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "cosmos:journey_error_ratio:rate1h{journey=\"core\"} / 0.005",
          "legendFormat": "1시간"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "cosmos:journey_error_ratio:rate5m{journey=\"core\"} / 0.005",
          "legendFormat": "5분"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-v2"
          },
          "expr": "cosmos:journey_error_ratio:rate6h{journey=\"core\"} / 0.005",
          "legendFormat": "6시간"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "파드와 배포",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "사용 가능한 파드 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-v2"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
