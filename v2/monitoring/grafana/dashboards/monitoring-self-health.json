{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-v2" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-v2" }, "expr": "up{job=~\"prometheus|grafana|loki|node-exporter\"}", "legendFormat": "{{job}}", "refId": "A" }],
      "title": "Monitoring Targets Up",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-v2" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-v2" }, "expr": "prometheus_tsdb_storage_blocks_bytes", "legendFormat": "Prometheus TSDB", "refId": "A" }],
      "title": "Prometheus Storage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-v2" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-v2" }, "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))", "legendFormat": "Loki ingest", "refId": "A" }],
      "title": "Loki Ingestion",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-v2" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus-v2" }, "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/srv/monitoring/data\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/srv/monitoring/data\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "data volume", "refId": "A" }],
      "title": "Monitoring Data Volume Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-v2" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki-v2" }, "expr": "{source=\"monitoring\"} |= \"error\"", "refId": "A" }],
      "title": "Monitoring Errors (available after log forwarding)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
