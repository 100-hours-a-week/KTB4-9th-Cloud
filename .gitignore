# ==========================================
# 1. 테라폼 상태 파일 (★ 절대 커밋 금지: 보안 및 충돌 방지)
# ==========================================
*.tfstate
*.tfstate.*
*.tfstate.backup

# ==========================================
# 2. 민감 정보 및 인증 키 파일 (★ 보안 사고 1위)
# ==========================================
# SSH 접속 키 파일 (예: cosmos-key-pair.pem)
*.pem
*.key

# 실제 시크릿/비밀번호가 들어가는 환경 변수 파일
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# 일반 환경변수 파일
.env
.env.*

# ==========================================
# 3. 테라폼 플러그인 캐시 및 실행 임시 파일
# ==========================================
# 프로바이더 바이너리가 수백 MB 다운로드되는 폴더
.terraform/

# 실행 시 임시 파일 및 계획 파일
*.tfplan
crash.log
crash.*.log
*.log

# ==========================================
# 4. OS 및 IDE 설정 파일 (Mac / VS Code / IntelliJ)
# ==========================================
.DS_Store
.idea/
.vscode/
*.swp
*~